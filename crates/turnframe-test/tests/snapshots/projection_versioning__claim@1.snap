        severity: info
  - state: under_review_incomplete
    phase: awaiting_review
    ownership: user
    obligations:
      - "{\"review_proposed_field\":{\"field\":\"merchant\"}}"
      - "{\"review_proposed_field\":{\"field\":\"total\"}}"
      - "{\"provide_field\":{\"field\":\"receipt_date\"}}"
    blocking:
