---
// Search over every page, by Pagefind: the index is built from the finished HTML after
// `astro build`, and loaded the first time the dialog opens.
---
<dialog class="tf search" data-search aria-label="Search the docs">
  <div class="search__bar">
    <svg class="tf-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><circle cx="7" cy="7" r="4.5"/><path d="M10.5 10.5L14 14"/></svg>
    <input type="search" placeholder="Search the docs" autocomplete="off" spellcheck="false" aria-label="Search" data-search-input />
    <button type="button" class="search__close" data-search-close aria-label="Close">Esc</button>
  </div>
  <ol class="search__results" data-search-results role="listbox" aria-label="Results"></ol>
  <p class="search__status" data-search-status aria-live="polite">Type to search the guides, the decision records and the changelog.</p>
</dialog>

<script is:inline type="module">
  // Plain JavaScript, left out of the bundle: the index only exists after the build, so its
  // import must reach the browser as written.
  const dialog = document.querySelector('[data-search]');
  const input = dialog.querySelector('[data-search-input]');
  const list = dialog.querySelector('[data-search-results]');
  const status = dialog.querySelector('[data-search-status]');
  const hint = status.textContent;
  let engine = null;
  let active = -1;

  let ready = false;
  const load = () =>
    (engine ??= (async () => {
      try {
        const pagefind = await import('/pagefind/pagefind.js');
        await pagefind.init();
        ready = true;
        return pagefind;
      } catch {
        status.textContent = 'The search index is written by npm run build; build the site once, then search.';
        return null;
      }
    })());

  const open = () => {
    if (!dialog.open) dialog.showModal();
    input.select();
    void load();
  };
  const close = () => dialog.close();

  const select = (index) => {
    const items = [...list.querySelectorAll('a')];
    if (!items.length) return;
    active = (index + items.length) % items.length;
    items.forEach((item, i) => item.setAttribute('aria-selected', String(i === active)));
    items[active].scrollIntoView({ block: 'nearest' });
  };

  const clean = (url) => url.replace(/\/index\.html$|\.html$/, '').replace(/\/$/, '') || '/';

  input.addEventListener('input', async () => {
    const query = input.value.trim();
    // The index loads on the first search: say so, rather than seem to do nothing.
    if (!ready && query) status.textContent = 'Loading the index…';
    const pagefind = await load();
    if (!pagefind) return;
    if (!query) {
      list.replaceChildren();
      status.textContent = hint;
      return;
    }
    const search = await pagefind.debouncedSearch(query);
    if (!search) return;
    const results = await Promise.all(search.results.slice(0, 8).map((result) => result.data()));
    list.replaceChildren(
      ...results.map((result) => {
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = clean(result.url);
        link.setAttribute('role', 'option');
        const title = document.createElement('b');
        title.textContent = result.meta.title ?? clean(result.url);
        const where = document.createElement('small');
        where.textContent = clean(result.url);
        const excerpt = document.createElement('span');
        excerpt.innerHTML = result.excerpt;
        link.append(title, where, excerpt);
        item.append(link);
        return item;
      }),
    );
    active = -1;
    if (results.length) select(0);
    const count = search.results.length;
    status.textContent = count ? `${count} result${count === 1 ? '' : 's'}` : `Nothing matches «${query}».`;
  });

  input.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault();
      select(active + (event.key === 'ArrowDown' ? 1 : -1));
    } else if (event.key === 'Enter') {
      const target = list.querySelectorAll('a')[active];
      if (target) window.location.href = target.href;
    }
  });

  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) close();
  });
  dialog.querySelector('[data-search-close]').addEventListener('click', close);
  document.querySelectorAll('[data-search-open]').forEach((button) => {
    button.addEventListener('click', open);
    // Reaching for the button is reason enough to start loading the index.
    button.addEventListener('pointerenter', () => void load(), { once: true });
    button.addEventListener('focus', () => void load(), { once: true });
  });
  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      dialog.open ? close() : open();
    } else if (event.key === '/' && !dialog.open && !/INPUT|TEXTAREA/.test(event.target.tagName)) {
      event.preventDefault();
      open();
    }
  });
</script>
