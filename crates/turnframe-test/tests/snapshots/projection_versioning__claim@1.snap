  - state: awaiting_extraction
    phase: extracting
    ownership: system
    obligations:
      - "{\"extract_fields\":{\"attachment_id\":\"att-receipt-1\"}}"
    notices: []
  - state: under_review
    phase: awaiting_review
    ownership: user
    obligations:
