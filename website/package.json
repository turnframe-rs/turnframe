{
  "name": "turnframe.rs",
  "private": true,
  "type": "module",
  "description": "The website of Turnframe, at turnframe.rs",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --output-subdir pagefind",
    "preview": "wrangler dev",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "deploy": "npm run build && npm test && wrangler deploy"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.0",
    "astro": "^7.3.5",
    "github-slugger": "^2.0.0",
    "markdown-it": "^15.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "smol-toml": "^1.9.0"
  },
  "devDependencies": {
    "pagefind": "^1.5.2",
    "wrangler": "^4.143.0"
  },
  "overrides": {
    "undici@7.29.0": "7.29.1"
  }
}
